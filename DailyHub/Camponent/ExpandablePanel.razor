@using Microsoft.AspNetCore.Components.Web
@using Radzen.Blazor

<div class="expandable-panel fade-in" style="@style">
    <div class="title-container" @onclick="ToggleContent">
        <span class="title">@Title</span>
        <hr />
        @if (!isExpanded)
       {
            <RadzenIcon Icon="arrow_circle_down" />
       }
       else{
            <RadzenIcon Icon="arrow_circle_up" />

       }
     
    </div>

    <div class="content" style="@(isExpanded ? "display: block;" : "display: none;")">
        @ChildContent
    </div>
</div>
<style>
    .expandable-panel {
        background: #f5f5f5;
        border-radius: 5px;
        padding: 10px;
        margin-bottom: 10px;
    }

    .header {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 5px;
        position: relative;
    }

    .toggle-icon {
        margin-left: 10px;
        font-size: 16px;
        color: gray;
    }

    .content {
        padding: 10px;
        /* background: white; */
        /* border-radius: 5px; */
        margin-top: 5px;
    }



    .title-container {
        display: flex;
        align-items: center;
        cursor: pointer;
        padding: 5px;
        position: relative;
    }

    .title {
        font-weight: bold;
        color: #5a2d82; /* رنگ بنفش */
        margin-right: 5px;
        white-space: nowrap;
    }

    hr {
        flex-grow: 1;
        border: none;
        border-top: 2px solid #5a2d82;
        margin: 0 10px;
    }

    .icon {
        font-size: 16px;
        color: gray;
    }
</style>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Title { get; set; } = "عنوان";
    [Parameter] public string style { get; set; } 
    [Parameter] public bool isExpanded { get; set; } = false;

    private void ToggleContent()
    {
        isExpanded = !isExpanded;
    }
}
