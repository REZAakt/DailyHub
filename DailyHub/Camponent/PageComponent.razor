    </div> *@

    <div class="MainContainer basepage-container" >
        <div class="basepage-header">
            @TopBarContents
        </div>
        <div class="basepage-body">
            @ChildContent
        </div>
    </div>
</div>


<style>
    .a_btnlink2 {
        font-size: small;
        white-space: normal; /* اجازه بده متن چند خطی بشه */
        word-break: break-word; /* بشکنه اگر کلمه خیلی طولانی بود */
        overflow-wrap: break-word; /* سازگاری بهتر */
        text-align: center;
        justify-content: center;
        display: flex;
    }

    @@media (max-width: 768px) {
        .a_btnlink2 {
            font-size: 12px;
        }
    }
</style>
<RadzenTooltip />
<RadzenNotification />
@if (IsLoading)
{
    <Waiting />
}

@code {
    public record TopBarArg(string? Address, string Text, EventCallback? ClickEvent = null);
    [Parameter] public List<TopBarArg> TopBarRoot { get; set; } = [];
    [Parameter] public RenderFragment? TopBarContents { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Style { get; set; } = string.Empty;

    #region IsLoading
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter]
    public EventCallback<bool> IsLoadingChanged { get; set; }
    private async Task OnIsLoadingChanged(bool IsLoadingTime)
    {
        // Notify parent about the change.
        await IsLoadingChanged.InvokeAsync(IsLoadingTime);
    }
    #endregion

}
