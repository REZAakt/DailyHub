@using Radzen.Blazor
@using Microsoft.AspNetCore.Components.Web

<style>
    .MainContainer {
        display: flex;
        flex-flow: column;
        gap: 0px;
        height:100%;
        overflow-y: hidden;
        overflow-x: hidden;
    }

    .list-border {
        border: hidden !important;
        /* border-radius: 15px; */
        /* padding: 5px; */
    }

    .list-footer {
        margin-right: 5px;
        /* border-radius: 15px; */
        /* padding: 5px; */
    }

    .list-In-border {
        /* border:hidden!important; */
        border-radius: 10px;
        /* padding: 5px; */
    }

    @@media (max-width: 768px) {
        .MainContainer {
            /* border:hidden!important; */
        }
    }
</style>

<div class="page-root" style="@Style">
@*     <div class="basepage-gap">
        <ol class="breadcrumb">
            @if (TopBarRoot is not null && TopBarRoot.Count > 0)
            {
                @for (int i = 0; i < TopBarRoot.Count - 1; i++)
