                        <a href="@TopBarRoot[index].Address"
                           @onclick="@(() => TopBarRoot[index].ClickEvent.HasValue
                                      ? TopBarRoot[index].ClickEvent!.Value.InvokeAsync()
                                      : Task.CompletedTask)">
                            @TopBarRoot[index].Text
                        </a>
                    </li>
                }

                <li>
                    <a href="@TopBarRoot.Last().Address" style="color:gray;">
                        @TopBarRoot.Last().Text
