<div id="@Id" style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; margin-top:50px;"></div>

@code {
    [Parameter] public string Id { get; set; } = "lottieContainer";
    [Parameter] public string Path { get; set; } = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("playLottie", Id, Path);
        }
    }

    [Inject] IJSRuntime JS { get; set; }
}
