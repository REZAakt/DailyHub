<RadzenTooltip />
<RadzenNotification />
@if (IsLoading)
{
    <Waiting />
}

<style>
    .site-base-container {
        display: flex;
        justify-content: center; /* محتوا وسط */
        align-items: flex-start; /* از بالا شروع شود */
        width: 100%;
        min-height: 100vh; /* حداقل ارتفاع صفحه کامل */
        overflow-y: auto;
        padding: 0px;
        box-sizing: border-box;
        background-color: transparent;
    }

    .site-inner-content {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding: 0px;
    }

    .site-header {
        /* استایل دلخواه برای هدر */
    }

    .site-body {
        flex-grow: 1;
    }

    .site-footer {
        flex-grow: 1;
        border-radius:20px;
        margin:1rem;
        /* background: linear-gradient(180deg, #E9F5FF 0%, #FAFAFA 100%); */
    }
    @@media (max-width: 768px) {
        .site-inner-content

    {
        width: 100%;
    }

    }

    .footer-content {
        color: white;
        text-align: center;
        padding: 60px 20px 30px 20px;
        position: relative;
        z-index: 1;
    }

    .footer-title {
        font-size: 28px;
        margin-bottom: 40px;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .footer-creators {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 40px;
        margin-bottom: 40px;
    }

    .creator-box {
        min-width: 220px;
    }

        .creator-box h3 {
            font-size: 20px;
            margin-bottom: 15px;
            font-weight: bold;
        }

    .social-icons {
        display: flex;
        justify-content: center;
        gap: 15px;
    }

        .social-icons a {
            color: white;
            font-size: 20px;
            transition: transform 0.3s ease, color 0.3s ease;
        }

            .social-icons a:hover {
                transform: scale(1.2);
                color: #ffd700; /* طلایی ملایم برای افکت hover */
            }

    .footer-copy {
        font-size: 14px;
        opacity: 0.7;
        margin-top: 20px;
    }

</style>

@code {
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;

    #region IsLoading
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter]
    public EventCallback<bool> IsLoadingChanged { get; set; }
    private async Task OnIsLoadingChanged(bool IsLoadingTime)
    {
        await IsLoadingChanged.InvokeAsync(IsLoadingTime);
    }
    #endregion
}
