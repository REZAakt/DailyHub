    }

    .list-footer {
        margin-right: 5px;
        /* border-radius: 15px; */
        /* padding: 5px; */
    }

    .list-In-border {
        /* border:hidden!important; */
        border-radius: 10px;
        /* padding: 5px; */
    }

    @@media (max-width: 768px) {
        .MainContainer {
            /* border:hidden!important; */
        }
    }
</style>