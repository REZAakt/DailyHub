@inherits LayoutComponentBase
@inject IJSRuntime JS

<RadzenLayout Style="background-color: transparent;">

    <RadzenHeader class="app-header" style="@HeaderBackground">
        <RadzenRow class="header-top" Style="padding: 0; height:100%;" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
            <RadzenColumn Size="8" Style="width:100%;" class="menu-col">
                <RadzenMenu Style="background-color:transparent;">
                    <RadzenMenuItem Text="خانــه" Icon="home" IconColor="#FCFCFC" Path="/Home"
                                    Style="font-size:16px; color:white !important; margin-right:10px; font-weight:400;" />
                    <RadzenMenuItem Text="ارز دیجیتال" Icon="currency_bitcoin" IconColor="#FCFCFC" Path="/Crypto/CryptoMainPage"
                                    Style="font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                    <RadzenMenuItem Text="اخبــار" Icon="newsmode" IconColor="#FCFCFC" Path="/News/NewsMainPage"
                                    Style="font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                    <RadzenMenuItem Text="آب و هوا" Icon="clear_day" IconColor="#FCFCFC" Path="/Weather/WeatherMainPage"
                                    Style="font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                    <RadzenMenuItem Text="چی کار می‌تونم بکنم برات؟" Icon="automation" IconColor="#FCFCFC" Path="/AI/AiMainPage"
                                    Style="font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                </RadzenMenu>
            </RadzenColumn>

            <RadzenColumn Size="4" Style="width:100%;height:100%; display:flex; align-items:flex-start; margin-top:5px;justify-content: end;padding-left: 10px; " class="logo-col">
                <RadzenImage Path="/images/Logo.svg"
                             Style="display:block; margin:0; padding:0; align-self:flex-start;" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenHeader>

