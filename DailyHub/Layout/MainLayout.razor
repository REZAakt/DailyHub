@code {
    bool sidebarExpanded = false;
    private string HeaderBackground = "";

    protected override void OnInitialized()
    {
        SetHeaderBackground();
        Navigation.LocationChanged += (s, e) =>
        {
            SetHeaderBackground();
            StateHasChanged();
        };
    }
    private void SetHeaderBackground()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();

        HeaderBackground = path switch
        {
            "" or "home" => "background: linear-gradient(to right, #008b9d, #6a68e0, #d82383);",
            "news/newsmainpage" => "background: linear-gradient(to right, #008b9d, #6a68e0, #940524);", // نارنجی-قرمز
            "/Crypto/CryptoMainPage" => "background: linear-gradient(to right, #008b9d, #6a68e0, #DDA201);", // آبی تیره
            "weather/weathermainpage" => "background: linear-gradient(to right, #008b9d, #6a68e0, #008cd3);", // آبی آسمانی
            "ai/aimainpage" => "background: linear-gradient(to right,#008b9d, #6a68e0, #3a0cbe);", // سبز-بنفش
            _ => "background: linear-gradient(to right, #6a11cb, #2575fc);" // پیش‌فرض
        };
    }

    #region CurrentWindow
    private int windowWidth;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("resizeListener.register", dotNetRef);
            windowWidth = await JS.InvokeAsync<int>("getWindowWidth");
        }
    }
    [JSInvokable]
    public Task OnResize(int width)
    {
        windowWidth = width;
        StateHasChanged();
        return Task.CompletedTask;
    }
    #endregion
}