            <RadzenPanelMenuItem Text="اخبــار" Icon="newsmode" IconColor="#6F7279" Path="/News/NewsMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
            <RadzenPanelMenuItem Text="تقویم" Icon="calendar_month" IconColor="#6F7279" Path="/Calendar/CalendarMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
            <RadzenPanelMenuItem Text="آب و هوا" Icon="clear_day" IconColor="#6F7279" Path="/Weather/WeatherMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
            <RadzenPanelMenuItem Text="چی کار می تونم بکنم برات ؟" Icon="automation" IconColor="#6F7279" Path="/AI/AiMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
        </RadzenPanelMenu>
      
    </RadzenSidebar> *@

    <RadzenBody Style=" background-color:transparent;">
        <div class="rz-p-12" style="height:100%; width:100%; background-color:transparent;">
            @Body
        </div>
    </RadzenBody>

