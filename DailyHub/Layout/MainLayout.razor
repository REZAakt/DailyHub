@inherits LayoutComponentBase
@inject IJSRuntime JS

<RadzenLayout Style="background-color: transparent;">

    @if (windowWidth > 768)
    {
        <RadzenHeader class="app-header">
            <!-- ردیف لوگو -->
            <RadzenRow class="header-top" Style="padding: 0;" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" class="logo-col">
                    <RadzenImage Path="/images/Logo.svg" class="logo" />
                </RadzenColumn>
            </RadzenRow>

            <!-- ردیف منو -->
            <RadzenRow class="nav-row" JustifyContent="JustifyContent.Center" Style="padding:0px;">
                <RadzenColumn Size="12" class="menu-col">
                    <RadzenMenu Style="background-color:transparent;">
                        <RadzenMenuItem Text="خانــه" Icon="home" IconColor="#FCFCFC" Path="/Home" Style="font-size:16px; color:white !important; margin-right:10px; font-weight:400;" />
                        <RadzenMenuItem Text="اخبــار" Icon="newsmode" IconColor="#FCFCFC" Path="/News/NewsMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                        <RadzenMenuItem Text="تقویم" Icon="calendar_month" IconColor="#FCFCFC" Path="/Calendar/CalendarMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                        <RadzenMenuItem Text="آب و هوا" Icon="clear_day" IconColor="#FCFCFC" Path="/Weather/WeatherMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                        <RadzenMenuItem Text="چی کار می تونم بکنم برات ؟" Icon="automation" IconColor="#FCFCFC" Path="/AI/AiMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                    </RadzenMenu>
                </RadzenColumn>
            </RadzenRow>
        </RadzenHeader>
    }
    @if (windowWidth <= 768)
    {
        <RadzenHeader class="app-header">
            <!-- ردیف لوگو -->
            <RadzenRow class="header-top" Style="padding: 0; height:100%;" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
                <RadzenColumn Size="3" Style="width:100%;" class="menu-col">
                    <RadzenMenu Style="background-color:transparent;">
                        <RadzenMenuItem Text="خانــه" Icon="home" IconColor="#FCFCFC" Path="/Home" Style="font-size:16px; color:white !important; margin-right:10px; font-weight:400;" />
                        <RadzenMenuItem Text="اخبــار" Icon="newsmode" IconColor="#FCFCFC" Path="/News/NewsMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                        <RadzenMenuItem Text="تقویم" Icon="calendar_month" IconColor="#FCFCFC" Path="/Calendar/CalendarMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                        <RadzenMenuItem Text="آب و هوا" Icon="clear_day" IconColor="#FCFCFC" Path="/Weather/WeatherMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                        <RadzenMenuItem Text="چی کار می تونم بکنم برات ؟" Icon="automation" IconColor="#FCFCFC" Path="/AI/AiMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
                    </RadzenMenu>
                </RadzenColumn>

                <RadzenColumn Size="6"
                              Style="width:100%; display:flex; justify-content:center; align-items:flex-start; ">
                    <RadzenImage Path="/images/Logo.svg"
                                 Style="display:block; margin:0; padding:0; align-self:flex-start;" />
                </RadzenColumn>

                <RadzenColumn Size="3" Style="width:100%;" class="logo-col">

                </RadzenColumn>
            </RadzenRow>
        </RadzenHeader>
    }

    @*     <RadzenSidebar FullHeight="true" Responsive="false" @bind-Expanded="@sidebarExpanded" style="position: absolute; z-index: 3">
        <RadzenStack AlignItems="AlignItems.End" class="rz-p-2">
            <RadzenButton Icon="west" Variant="Variant.Text" ButtonStyle="ButtonStyle.Secondary" Click="@(() => sidebarExpanded = false)" />
        </RadzenStack>
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="خانــه" Icon="home" IconColor="#6F7279" Path="/Home" Style="font-size:16px; color:white !important; margin-right:10px; font-weight:400;" />
            <RadzenPanelMenuItem Text="اخبــار" Icon="newsmode" IconColor="#6F7279" Path="/News/NewsMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
            <RadzenPanelMenuItem Text="تقویم" Icon="calendar_month" IconColor="#6F7279" Path="/Calendar/CalendarMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
            <RadzenPanelMenuItem Text="آب و هوا" Icon="clear_day" IconColor="#6F7279" Path="/Weather/WeatherMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
            <RadzenPanelMenuItem Text="چی کار می تونم بکنم برات ؟" Icon="automation" IconColor="#6F7279" Path="/AI/AiMainPage" Style=" font-size:16px;color:white;margin-right:10px;font-weight:400;" />
        </RadzenPanelMenu>

    </RadzenSidebar> *@

    <RadzenBody Style=" background-color:transparent;">
        <div class="rz-p-12" style="height:100%; width:100%; background-color:transparent;">
            @Body
        </div>
    </RadzenBody>

    @*  <RadzenFooter>
        Footer
    </RadzenFooter> *@
</RadzenLayout>

@code {
    bool sidebarExpanded = false;

    #region CurrentWindow
    private int windowWidth;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("resizeListener.register", dotNetRef);
            windowWidth = await JS.InvokeAsync<int>("getWindowWidth");
        }
    }
    [JSInvokable]
    public Task OnResize(int width)
    {
        windowWidth = width;
        StateHasChanged();
        return Task.CompletedTask;
    }
    #endregion
}