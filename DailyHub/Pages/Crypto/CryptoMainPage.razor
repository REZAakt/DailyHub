@page "/Crypto/CryptoMainPage"
@using DailyHub.Shared.Dto.Crypto
@inject IJSRuntime JS

@inject CryptoRealtimeService Crypto

<BasePage IsLoading="IsLoading">
    <HeaderContent>
        <RadzenAlert AlertStyle="AlertStyle.Danger" @bind-Visible="_offline" ShowIcon="false" Variant="Variant.Flat" Shade="Shade.Lighter"
                     style="margin:1rem 1rem; border-radius:18px;width:98%; box-shadow: 0 0px 30px rgba(0, 0, 0, 0.1) !important;">
            <RadzenText style="color:red; font-weight:800; font-size:16px;"
                        Text="اتصال شما به سرور برقرار نشد ، لطفا با پشتیبانی تماس بگیرید . " />
        </RadzenAlert>
    </HeaderContent>

    <ChildContent>
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%; height:100%;" Wrap="FlexWrap.Wrap">
            <RadzenCard class="fade-in" Style="padding:1rem; max-width:1600px; margin:0 auto;border-radius:20px; width:97%;">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:1rem; margin:0.2rem 0.5rem 0.8rem 0.5rem;">
                    <div style="font-weight:900; font-size:18px;">قیمت رمزارزها</div>
                    <RadzenButton Icon="refresh" Text="بروزرسانی" Click="Refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
                </div>
                @if (Items is null)
                {
                    <div>در حال دریافت…</div>
                }
                else if (Items.Count == 0)
                {
                    <div>داده‌ای برای نمایش نیست.</div>
                }
                else
                {
                    @if (windowWidth > 800)
                    {
                        <RadzenDataGrid TItem="CryptoItemDto" Data="@Items" AllowPaging="true" PageSize="10" Responsive="false">
                            <Columns>
                                <RadzenDataGridColumn TItem="CryptoItemDto" Title="#" Width="40px">
                                    <Template Context="c">@(Items.IndexOf(c) + 1)</Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="CryptoItemDto" Title="نام" Width="220px">
                                    <Template Context="c">
                                        <div style="display:flex; align-items:center; gap:.5rem;">
                                            <img src="@c.Image" style="width:28px;height:28px;border-radius:50%;" />
                                            <div>
                                                <div style="font-weight:800">@c.Name (@c.Symbol.ToUpper())</div>
                                                <div style="font-size:12px; opacity:.7;">@c.LastUpdated:g</div>
                                            </div>
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="CryptoItemDto" Title="قیمت (USD)" Width="130px">
                                    <Template Context="c">@c.CurrentPrice.ToString("N2")</Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="CryptoItemDto" Title="۷ روز " Width="100px">
                                    <Template Context="c">
                                        @{
                                            var v = c.PriceChangePct7d;
                                        }
                                        @if (v is null)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <span style="font-weight:700;color:@(v >= 0 ? "green" : "red")">@v.Value.ToString("0.##")%</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="CryptoItemDto" Title="۳۰ روز " Width="100px">
                                    <Template Context="c">
                                        @{
                                            var v = c.PriceChangePct30d;
                                        }
                                        @if (v is null)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <span style="font-weight:700;color:@(v >= 0 ? "green" : "red")">@v.Value.ToString("0.##")%</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="CryptoItemDto" Title="۲۰۰ روز " Width="110px">
                                    <Template Context="c">
                                        @{
                                            var v = c.PriceChangePct200d;
                                        }
                                        @if (v is null)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <span style="font-weight:700;color:@(v >= 0 ? "green" : "red")">@v.Value.ToString("0.##")%</span>
                                        }
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="CryptoItemDto" Title="حجم ۲۴ساعت" Width="140px">
                                    <Template Context="c">@c.TotalVolume.ToString("N0")</Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                    @if (windowWidth < 800)
                    {
                        <RadzenDataList TItem="CryptoItemDto" Data="@Items" AllowPaging="true" PageSize="10"
                                        Style="width:100%;"
                                        Class="crypto-list">

                            <Template Context="c">
                                <div class="crypto-card">
                                    <div class="crypto-header">
                                        <img src="@c.Image" alt="@c.Name" class="crypto-img" />
                                        <div class="crypto-name">
                                            <div class="name">@c.Name (@c.Symbol.ToUpper())</div>
                                            <div class="time">@c.LastUpdated:g</div>
                                        </div>
                                        <div class="index">#@(@Items.IndexOf(c) + 1)</div>
                                    </div>

                                    <div class="crypto-body">
                                        <div><b>قیمت:</b> @c.CurrentPrice.ToString("N2") <span class="usd">USD</span></div>
                                        <div>
                                            <b>۷ روز:</b> <span style="color:@(c.PriceChangePct7d >= 0 ? "green" : "red")">
                                                @(c.PriceChangePct7d?.ToString("0.##") ?? "—")%
                                            </span>
                                        </div>
                                        <div>
                                            <b>۳۰ روز:</b> <span style="color:@(c.PriceChangePct30d >= 0 ? "green" : "red")">
                                                @(c.PriceChangePct30d?.ToString("0.##") ?? "—")%
                                            </span>
                                        </div>
                                        <div>
                                            <b>۲۰۰ روز:</b> <span style="color:@(c.PriceChangePct200d >= 0 ? "green" : "red")">
                                                @(c.PriceChangePct200d?.ToString("0.##") ?? "—")%
                                            </span>
                                        </div>
                                        <div><b>حجم ۲۴س:</b> @c.TotalVolume.ToString("N0")</div>
                                    </div>
                                </div>
                            </Template>

                        </RadzenDataList>
                    }
                }
            </RadzenCard>

            @* 1) قیمت (USD) همه کوین‌ها *@

            <RadzenCard class="fade-in" dir="ltr" Style="padding:2rem; max-width:1600px; margin:0 auto;border-radius:20px; width:97%;">
                <div style="font-weight:900; margin-bottom:.5rem;">قیمت (USD)</div>
                <RadzenChart Style="width:100%; height:480px;">
                    <RadzenColumnSeries TItem="CryptoItemDto"
                                        Data="@(Items ?? new())"
                                        CategoryProperty="Name"
                                        ValueProperty="CurrentPrice"
                                        Title="قیمت (USD)"
                                        Stroke="#DDA201" />
                    <RadzenLegend Position="LegendPosition.Bottom" />
                    <RadzenCategoryAxis LabelAutoRotation="15" Stroke="#060270" StrokeWidth="2" TickDistance="50" />
                    <RadzenValueAxis Stroke="#060270" StrokeWidth="2" Formatter="@(v => string.Format(System.Globalization.CultureInfo.InvariantCulture, "{0:N0}", v))" />
                    <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" Fill="#84E1F1" Stroke="#060270" StrokeWidth="2" />
                    <RadzenChartTooltipOptions Shared="true" />
                </RadzenChart>
            </RadzenCard>



            @* 2) چارت خطی: درصد تغییرات ۷ / ۳۰ / ۲۰۰ روز *@

            <RadzenCard class="fade-in" dir="ltr" Style="padding:2rem; max-width:1600px; margin:1rem auto;border-radius:20px; width:97%;">
                <div style="font-weight:900; margin-bottom:.5rem;"> درصد تغییرات ( ۷ ، ۳۰ و ۲۰۰ روزه )</div>
                <RadzenChart Style="width:100%; height:520px;">
                    <RadzenChartTooltipOptions Shared="true" />
                    <RadzenChartTooltip />

                    <RadzenLineSeries TItem="CryptoChartRow"
                                      Data="@ChartRows"
                                      CategoryProperty="Name"
                                      ValueProperty="Pct7d"
                                      Title="۷ روز"
                                      Hidden="@Hide7"
                                      Stroke="#0f9d58"
                                      LineType="LineType.Solid" />

                    <RadzenLineSeries TItem="CryptoChartRow"
                                      Data="@ChartRows"
                                      CategoryProperty="Name"
                                      ValueProperty="Pct30d"
                                      Title="۳۰ روز"
                                      Hidden="@Hide30"
                                      Stroke="#AA03D8"
                                      LineType="LineType.Solid" />

                    <RadzenLineSeries TItem="CryptoChartRow"
                                      Data="@ChartRows"
                                      CategoryProperty="Name"
                                      ValueProperty="Pct200d"
                                      Title="۲۰۰ روز"
                                      Hidden="@Hide200"
                                      Stroke="#e53935"
                                      LineType="LineType.Solid" />

                    <RadzenLegend Position="LegendPosition.Bottom" />
                    <RadzenCategoryAxis LabelAutoRotation="15" Stroke="#060270" StrokeWidth="2" TickDistance="50" />
                    <RadzenValueAxis Stroke="#060270" StrokeWidth="2" />
                    <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle"
                                   Fill="#84E1F1" Stroke="#060270" StrokeWidth="2" />
                </RadzenChart>
            </RadzenCard>

            @* 3) حجم ۲۴ساعت (نمودار دایره‌ای) *@

            <RadzenCard class="fade-in" dir="ltr" Style="padding:2rem; max-width:1600px; margin:0 auto;border-radius:20px; width:97%;">
                <div style="font-weight:900; margin-bottom:.5rem;">سهم رمزارزها از حجم معاملات ۲۴ساعت</div>

                <RadzenChart Style="width:100%; height:560px;">
                    <RadzenChartTooltipOptions Shared="true" />
                    <RadzenPieSeries TItem="CryptoItemDto"
                                     Data="@(Items?.OrderByDescending(x => x.TotalVolume).ToList() ?? new())"
                                     CategoryProperty="Name"
                                     ValueProperty="TotalVolume"
                                     Title="سهم حجم ۲۴ساعت"
                                     StrokeWidth="1" />
                    <RadzenMarkers Visible="true" MarkerType="MarkerType.Circle" Fill="#84E1F1" Stroke="#060270" StrokeWidth="2" />

                    <RadzenLegend Position="LegendPosition.Bottom" />
                </RadzenChart>
            </RadzenCard>

        </RadzenStack>

    </ChildContent>
</BasePage>

@code {


    enum S { S7, S30, S200 }
    S sel = S.S7;
    bool Hide7 => sel != S.S7;
    bool Hide30 => sel != S.S30;
    bool Hide200 => sel != S.S200;

    //     List<SeriesColorRange> priceColorRanges = new()
    // {
    //     new SeriesColorRange { Min = 0, Max = 10000, Color = "#EF4444" },
    //     new SeriesColorRange { Min = 10000, Max = 30000, Color = "#FACC15" },
    //     new SeriesColorRange { Min = 30000, Max = double.MaxValue, Color = "#22C55E" }
    // };

    // ردیف‌های چارت خطی (null => 0)
    private List<CryptoChartRow> ChartRows =>
        (Items ?? new()).Select(x => new CryptoChartRow
        {
            Name = x.Name,
            Pct7d = x.PriceChangePct7d ?? 0m,
            Pct30d = x.PriceChangePct30d ?? 0m,
            Pct200d = x.PriceChangePct200d ?? 0m
        }).ToList();

    public class CryptoChartRow
    {
        public string Name { get; set; } = "";
        public decimal Pct7d { get; set; }
        public decimal Pct30d { get; set; }
        public decimal Pct200d { get; set; }
    }

    private bool IsLoading { get; set; } = true;
    private bool _offline;
    private List<CryptoItemDto>? Items;
    private IEnumerable<ChangePoint> Change7d =>
    (Items ?? Enumerable.Empty<CryptoItemDto>())
    .Where(x => x.PriceChangePct7d.HasValue)
    .Select(x => new ChangePoint(x.Name, x.PriceChangePct7d!.Value));

    public record ChangePoint(string Label, decimal Value);
    // لیست پیش‌فرض
    private const string CoinIds = "bitcoin,ethereum,solana,binancecoin,ripple,cardano,tron,chainlink,polygon,toncoin";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Crypto.OnCryptoUpdated += (key, list) =>
            {
                if (!string.Equals(key, CoinIds, StringComparison.OrdinalIgnoreCase)) return;
                Items = list ?? new();
                _offline = false;
                IsLoading = false;
                InvokeAsync(StateHasChanged);
            };

            await Crypto.StartAsync();
            await Crypto.SubscribeAsync(CoinIds);
        }
        catch
        {
            _offline = true;
            IsLoading = false;
        }
    }

    private async Task Refresh()
    {
        try
        {
            IsLoading = true;
            await Crypto.SubscribeAsync(CoinIds, force: true);
            _offline = false;
        }
        catch
        {
            _offline = true;
        }
        finally
        {
            IsLoading = false;
        }
    }

    #region CurrentWindow
    private int windowWidth;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("resizeListener.register", dotNetRef);
            windowWidth = await JS.InvokeAsync<int>("getWindowWidth");
        }
    }
    [JSInvokable]
    public Task OnResize(int width)
    {
        windowWidth = width;
        StateHasChanged();
        return Task.CompletedTask;
    }
    #endregion


}