@page "/AI/AiMainPage"
@using DailyHub.Shared.Dto.Ai
@using DailyHub.Shared.Enums
@using System.Text.Json
@inject DeepseekRealtimeService ChatSrv
@inject IJSRuntime JS

<style>
    .chat-wrap {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 180px);
    max-width: 75%;
    margin: 0 auto;
    }

    .Headerdiv {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 75%;
    margin: 1rem auto;
    background-color: white;
    border-radius: .5rem;
    box-shadow: 0 0px 10px rgba(0, 0, 0, 0.15);
    margin-top: 30px;
    }

    @@media(max-width: 780px) {
    .chat-wrap {
    max-width: 95%;
    }

    .Headerdiv {
    max-width: 95%;
    }
    }

    .chat-log {
    flex: 1;
    overflow: auto;
    border: 1px solid var(--rz-base-300);
    border-radius: 14px;
    padding: 12px;
    background: var(--rz-base-50);
    background-color: #212121;
    }

    .msg {
    max-width: 80%;
    text-wrap: wrap;
    padding: .75rem 1rem;
    border-radius: 14px;
    margin: .4rem 0;
    white-space: pre-wrap;
    line-height: 1.5;
    animation: fadeIn 0.3s ease-in;
    /* animation: pulse 1s infinite; */
    }

    .msg.user {
    margin-left: auto;
    background: #DCF1FF;
    border: 1px solid #BFE4FF
    }

    .msg.ai {
    margin-right: auto;
    background: #F6F6F6;
    border: 1px solid #E2E2E2
    }

    .msg.pending {
    opacity: .8
    }

    .toolbar {
    display: flex;
    gap: .5rem;
    margin-top: .75rem
    }

    .input-box {
    display: flex;
    gap: .5rem;
    align-items: flex-end;
    margin-top: 8px
    }

    textarea {
    width: 100%;
    min-height: 70px;
    border-radius: 12px;
    border: 1px solid var(--rz-base-300);
    padding: .75rem
    }

    .badge {
    padding: 5px 8px;
    background: #5686FE;
    border-radius: 9px;
    font-size: .75rem;
    justify-content: left;
    display: flex;
    margin-inline-start: 6px
    }

    @@keyframes fadeIn {
    from {
    opacity: 0;
    transform: translateY(10px);
    }

    to {
    opacity: 1;
    transform: translateY(0);
    }
    }

    @@keyframes pulse {
    0% {
    opacity: 0.7;
    }

    50% {
    opacity: 1;
    }

    100% {
    opacity: 0.7;
    }
    }

    .chat-input {
    font-size: 16px;
    font-weight: 600;
    max-height: 50px !important;
    border: none;
    background-color: #303030;
    color: white;
    direction: rtl;
    resize: none; /* اگه نمی‌خوای کاربر بکشه بزرگش کنه */
    }

    .chat-input:focus {
    outline: none;
    box-shadow: none;
    border: none;
    }
</style>

<BasePage IsLoading="IsLoading">
    <HeaderContent>
        <RadzenAlert AlertStyle="AlertStyle.Danger" @bind-Visible="_offline" ShowIcon="false" Variant="Variant.Flat" Shade="Shade.Lighter"
        style="margin:1rem 1rem; border-radius:18px;width:98%; box-shadow: 0 0px 30px rgba(0, 0, 0, 0.1) !important;">
            <RadzenText style="color:red; font-weight:800; font-size:16px;" Text="  اتصال شما برقرار نشد. ابتدا از اتصال به اینترنت اطمینان حاصل کنید و صفحه را  (Refresh)  کنید ." />
        </RadzenAlert>
        <div class="Headerdiv fade-in">
            <div style="width:max-content; height:max-content; display:flex; justify-content:center;min-width:100%;">
                <ExpandablePanel Title="تنظیمات" style="background-color:white; min-width:100%;margin-top:-13px;">
                    <div style="margin:10px 0px;display:flex; justify-content:left;">
                        DeepSeek
                        <span class="badge">مدل: @Settings.Model</span>
                    </div>
                    <div style="display:flex;gap:.75rem;align-items:center;margin-top:.5rem;opacity:.85 ; flex-wrap:wrap;margin:10px 0px;">
                        <label>MaxTokens</label>
                        <RadzenNumeric @bind-Value="_maxTokens" Min="64" Max="2048" Style="max-width:120px" />

                        <label>Temp</label>
                        <RadzenNumeric @bind-Value="_temperature" Step="0.1" Min="0" Max="2" Style="max-width:120px" />

                        <RadzenDropDown @bind-Value="_model"
                        Data="Models" Style="max-width:220px"
                        Placeholder="مدل" />

                        <span style="margin-inline-start:auto;opacity:.7">ذخیره‌ی جلسه: sessionStorage</span>

                        <div class="badge" style="font-size:1rem ;background-color:blueviolet; margin:1px 4px;">پیام‌ها: @Messages.Count</div>
                    </div>
                    <RadzenButton Style="margin-top:10px !important; " ButtonStyle="ButtonStyle.Secondary" Icon="save" Click="@ApplySettings">
                        اعمال تنظیمات
                    </RadzenButton>
                </ExpandablePanel>
            </div>
        </div>
    </HeaderContent>

    <ChildContent>

        <div class="chat-wrap fade-in">
            <div id="chatlog" class="chat-log">
                @foreach (var m in Messages)
                {
                    <div class="msg @(m.Role == ChatRole.user ? "user" : "ai")">
                        @m.Content
                    </div>
                }
                @if (IsStreaming)
                {
                    <div class="msg ai pending">@StreamingBuffer</div>
                }
                @if (!string.IsNullOrEmpty(ErrorText))
                {
                    <div class="msg ai" style="border-color:#ffb3b3;background:#fff2f2">
                        <div>@ErrorText</div>
                        <div class="toolbar">
                            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="replay" IconColor="#fff" Click="ResendLast"></RadzenButton>
                        </div>
                    </div>
                }
            </div>

            <div class="input-box" dir="ltr" style="background-color:#303030; border-radius:10px;">
                <textarea class="chat-input" @bind="@UserInput" @bind:event="oninput" placeholder="هرچی می خوای بپرس  ... " @onkeydown="OnKeyDown"></textarea>
                <div style="display:flex;flex-direction:column;gap:.5rem;  padding: 5px; ">
                    <RadzenButton Icon="send" IconColor="#fff" Style="font-size:40px;width:70px ;height:70px; direction:rtl; border-radius:999px; display:revert;"
                    Disabled="@(IsStreaming || string.IsNullOrWhiteSpace(UserInput))"
                    Click="Send" />

                    @*     <RadzenButton Icon="stop"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Disabled="@(!IsStreaming)"
                                  Click="Stop">توقف</RadzenButton>  *@

                </div>

            </div>

        </div>
    </ChildContent>
</BasePage>

@code {
    private int _maxTokens = 512;
    private double _temperature = 0.7;
    private string _model = "deepseek-chat";
    private bool _offline = false;
    private readonly string[] Models = new[] { "deepseek-chat", "deepseek-reasoner" };
    private ChatSettingsDto Settings { get; set; } = new() { Model = "deepseek-chat", MaxTokens = 512, Temperature = 0.7 };
    public bool IsLoading { get; set; } = true;
    private List<ChatMessageDto> Messages = new();
    private string UserInput = "";
    private bool IsStreaming = false;
    private string StreamingBuffer = "";
    private string? ErrorText = null;
    private CancellationTokenSource? _cts;

    #region Notife

    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
    }
    #endregion

    private ChatSettingsDto BuildSettings() => new ChatSettingsDto
        {
            Model = _model,
            MaxTokens = _maxTokens,
            Temperature = _temperature
        };

    private void ApplySettings()
    {
        Settings = BuildSettings();
        // اگر جایی لازم داری Settings نگهداری شود:

        NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = MainText.SuccessOP,
                Detail = "تنظیمات با موفقیت اعمال شد",
                Duration = 4000,
            });

        StateHasChanged();
    }

    // مثالِ ارسال پیام:
    private async Task SendAsync()
    {
        var settings = BuildSettings();
        // ... call hub/provider with `settings`
    }

    // تنظیمات درخواست

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        ChatSrv.OnDelta += OnDelta;
        ChatSrv.OnCompleted += OnCompleted;
        ChatSrv.OnError += OnError;

        try
        {
            await ChatSrv.StartAsync();
            await LoadSession();
            _offline = false;
        }
        catch (Exception ex)
        {
            _offline = true;
            IsLoading = false;
        }
        ScrollToEnd();
        IsLoading = false;
    }

    async Task Send()
    {
        IsLoading = true;
        ErrorText = null;
        var content = UserInput?.Trim();
        if (string.IsNullOrEmpty(content)) return;

        // پیام کاربر
        Messages.Add(new(ChatRole.user, content));
        UserInput = "";
        await SaveSession();
        ScrollToEnd();

        // شروع استریم
        IsStreaming = true;
        StreamingBuffer = "";
        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        var msgs = new List<ChatMessageDto>(Messages); // کل کانتکست

        _ = ChatSrv.StreamAsync(msgs, Settings, _cts.Token); // fire&forget
        IsLoading = false;
    }

    void Stop()
    {
        _cts?.Cancel();
        IsStreaming = false;
    }

    void ResendLast()
    {
        if (Messages.Count == 0) return;
        // آخرین پیام کاربر را دوباره می‌فرستیم
        var lastUser = Messages.LastOrDefault(m => m.Role == ChatRole.user);
        if (lastUser is null) return;

        UserInput = lastUser.Content;
        ErrorText = null;
        _ = Send();
    }

    void OnDelta(string delta)
    {
        StreamingBuffer += delta;
        InvokeAsync(StateHasChanged);
        ScrollToEnd();
    }

    async void OnCompleted(string? full)
    {
        if (!string.IsNullOrEmpty(full))
        {
            Messages.Add(new(ChatRole.assistant, full));
            await SaveSession();
        }
        IsStreaming = false;
        StreamingBuffer = "";
        await InvokeAsync(StateHasChanged);
        ScrollToEnd();
    }

    async void OnError(string err)
    {
        ErrorText = err;
        IsStreaming = false;
        StreamingBuffer = "";
        await InvokeAsync(StateHasChanged);
        ScrollToEnd();
    }

    void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !IsStreaming && !string.IsNullOrWhiteSpace(UserInput))
        {
            _ = Send();
        }
    }

    async Task SaveSession()
    {
        var obj = new { messages = Messages, settings = Settings };
        await JS.InvokeVoidAsync("sessionStorage.setItem", "chat_session", JsonSerializer.Serialize(obj));
    }

    async Task LoadSession()
    {
        var s = await JS.InvokeAsync<string>("sessionStorage.getItem", "chat_session");
        if (!string.IsNullOrEmpty(s))
        {
            try
            {
                using var doc = JsonDocument.Parse(s);
                var root = doc.RootElement;
                if (root.TryGetProperty("messages", out var msgs) && msgs.ValueKind == JsonValueKind.Array)
                {
                    Messages = msgs.Deserialize<List<ChatMessageDto>>() ?? new();
                }
                if (root.TryGetProperty("settings", out var st))
                {
                    var m = st.Deserialize<ChatSettingsDto>();
                    if (m is not null) Settings = m;
                }
            }
            catch { /* ignore */ }
        }
    }

    async Task ResetSession()
    {
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "chat_session");
        Messages.Clear();
        ErrorText = null;
        StreamingBuffer = "";
        StateHasChanged();
    }

    async void ScrollToEnd()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "let el=document.getElementById('chatlog'); if(el) el.scrollTop=el.scrollHeight;");
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        ChatSrv.OnDelta -= OnDelta;
        ChatSrv.OnCompleted -= OnCompleted;
        ChatSrv.OnError -= OnError;
        _cts?.Dispose();
        await SaveSession();
    }
}
