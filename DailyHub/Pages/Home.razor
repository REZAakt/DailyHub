                <RadzenCard class="chat-card card4" @onclick="() => NavManageer(AddressBar.News)">
                    <div class="chat-card-icon">
                        <div class="chat-card-slot">
                            <JsonPlayer Id="4" Path="images/News.json" />
                        </div>
                    </div>
                    <div class="chat-card-content">
                        <h3>بیرون چه خبره ؟</h3>
                        <p>اخبار روز رو از اینجا دنبال کن</p>
                    </div>
                </RadzenCard>
            </div>

            @* </RadzenStack> *@

            @*   <RadzenCard class="wx-card fade-in" Style="margin-top:1rem;">

            </RadzenCard> *@
        </div>

    </ChildContent>
</BasePage>

@code {
    public bool IsLoading { get; set; } = true;
    private bool _offline;
    private readonly List<OnThisDayItemDto> _items = new();
    private string _lang = "fa";
    private int _m = DateTime.Today.Month, _d = DateTime.Today.Day;

    private void NavManageer(AddressBar Address)
    {
        if (Address == AddressBar.Crypto)
        {
            _NavigationManager.NavigateTo("Crypto/CryptoMainPage");
        }
        else if (Address == AddressBar.News)
        {
            _NavigationManager.NavigateTo("News/NewsMainPage");
        }
        else if (Address == AddressBar.AiCaht)
        {
            _NavigationManager.NavigateTo("AI/AiMainPage");
        }
        else if (Address == AddressBar.Wheater)
        {
            _NavigationManager.NavigateTo("Weather/WeatherMainPage");
        }
    }

    private static string Norm(string? s) => (s ?? "").Trim().ToLowerInvariant();

    private List<OnThisDayItemDto> GetFeatured(int n)
    {
        IEnumerable<OnThisDayItemDto> src = _items.Where(i => Norm(i.Type) == "selected");
        if (!src.Any())
            src = _items.Where(i => Norm(i.Type) == "events");

        return src
            .OrderByDescending(i => !string.IsNullOrWhiteSpace(i.Thumbnail))
            .ThenByDescending(i => i.Year)
            .Take(n)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        //میخوای صفحه ارور رو تست کنی ؟
        // throw new Exception("Test Blazor Error UI");

        try
        {
            Otd.OnOtdUpdated += (_, list) =>
            {
                _items.Clear();
                if (list is not null) _items.AddRange(list);
                IsLoading = false;
                _offline = false;
                InvokeAsync(StateHasChanged);
            };

            await Otd.StartAsync();
            // یک‌بار سابسکرایب + آپدیت شبانهٔ خودکار
            await Otd.SubscribeAsync(_lang, "all", _m, _d, autoRefresh: true);
        }
        catch
        {
            _offline = true;
            IsLoading = false;
        }
    }

    #region CurrentWindow
    // private int windowWidth;


    // protected override async Task OnAfterRenderAsync(bool firstRender)
    // {
    //     if (firstRender)
    //     {
    //         StateHasChanged();
    //         var dotNetRef = DotNetObjectReference.Create(this);
    //         await JS.InvokeVoidAsync("resizeListener.register", dotNetRef);

    //         windowWidth = await JS.InvokeAsync<int>("getWindowWidth");

    //         await InvokeAsync(StateHasChanged);
    //     }
    // }

    // [JSInvokable]
    // public Task OnResize(int width)
    // {
    //     windowWidth = width;

    //     return InvokeAsync(StateHasChanged);
    // }
    #endregion


    private async Task Refresh()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            await Otd.RefreshOnceAsync(_lang, "all", _m, _d);

            _offline = false;
            IsLoading = false;
        }
        catch
        {
            _offline = true;
            IsLoading = false;
        }
    }

    private static string StripHtml(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var decoded = WebUtility.HtmlDecode(s);
        // حذف تمام تگ‌های HTML
        return Regex.Replace(decoded, "<.*?>", "").Trim();
    }

    private static string SafeTitle(OnThisDayItemDto it)
        => StripHtml(!string.IsNullOrWhiteSpace(it.Title) ? it.Title : it.Text);

}
