@page "/Home"
@using DailyHub.Shared.Dto.Otd
@inject OnThisDayRealtimeService Otd
@using System.Net
@using System.Text.RegularExpressions

<style>
    .wx-wrap {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 100%;
        padding: clamp(12px, 2vw, 20px); /* فاصله از چهار طرف صفحه */
        max-width: 1500px;
        margin: 0 auto; /* محتوا وسط صفحه و محدود */
    }

    .wx-section-title {
        margin: 5px;
        font-weight: 700;
        font-size: 16px;
    }

    .wx-card, .wx-side {
        border-radius: 16px;
        height: 100%;
        min-width: 100%;
        padding: 1rem;
        box-shadow: 0 0px 15px rgba(0,0,0,.03); /* سایه نرم و یکنواخت */
        background: #fff;
    }

    .wx-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .wx-city {
        font-size: 1.4rem;
        font-weight: 900;
    }

    .wx-time {
        font-size: .9rem;
        opacity: .7;
    }

    .wx-loading {
        padding: .5rem 0;
    }

    .wx-today {
        display: flex;
        gap: 1rem;
        align-items: center;
    }

    .wx-today-left {
        display: flex;
        flex-direction: column;
        gap: .35rem;
        flex: 1;
    }

    .wx-temp-now {
        font-size: 2.2rem;
        font-weight: 900;
        line-height: 1.2;
    }

    .wx-temp-range, .wx-precip, .wx-code {
        font-size: .95rem;
    }

    .wx-today-right {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        max-width: 150px;
        max-height: 150px;
    }

    .wx-video {
        width: 180px;
        height: 140px;
        object-fit: cover;
        border-radius: 12px;
    }

    .wx-side-title {
        font-weight: 800;
        margin-bottom: .75rem;
    }

    .wx-side-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .5rem .75rem;
        font-size: .95rem;
    }

    .min-grid .rz-datatable-table {
        min-width: 640px;
    }

    .ChartClass {
        height: 340px;
        margin: 0px 1rem;
    }

    /* --- موبایل --- */
    @@media (max-width: 768px) {
        .wx-title {
            flex-direction: column;
            align-items: flex-start;
            gap: .25rem;
        }
        /* ردیف بالایی حتماً زیر هم بیاید */
        .wx-row {
            flex-direction: column !important;
        }
            /* تضمین استک‌شدن ستون‌ها */
            .wx-row .rz-column {
                flex: 0 0 100% !important;
                max-width: 100% !important;
            }

        .wx-today {
            flex-direction: column;
            align-items: stretch;
        }

        .wx-today-right {
            justify-content: stretch;
            width: 155px;
            height: 155px;
        }

        .wx-video {
            width: 100%;
            height: 100%;
            aspect-ratio: 16/9;
            object-fit: cover;
            border-radius: 12px;
        }

        .wx-wrap {
            padding: 12px;
        }
        /* کمی جمع‌وجورتر در موبایل */
        .wx-card, .wx-side {
            min-width: 100%;
            box-shadow: 0 0px 15px rgba(0,0,0,.03);
        }
        /* سایه نرم‌تر */
        .ChartClass {
            height: 340px;
            margin: 0px 1px;
        }
    }
</style>

<BasePage IsLoading="IsLoading">
    <HeaderContent>
        <RadzenAlert AlertStyle="AlertStyle.Danger" @bind-Visible="_offline" ShowIcon="false" Variant="Variant.Flat" Shade="Shade.Lighter"
                     style="margin:1rem 1rem; border-radius:18px;width:98%; box-shadow: 0 0px 30px rgba(0, 0, 0, 0.1) !important;">
            <RadzenText style="color:red; font-weight:800; font-size:16px;"
                        Text="اتصال شما برقرار نشد. ابتدا از اتصال به اینترنت اطمینان حاصل کنید و صفحه را (Refresh) کنید." />
        </RadzenAlert>
    </HeaderContent>

    <ChildContent>
        <div dir="rtl" class="wx-wrap">
            <RadzenRow class="wx-row" Style="align-items: stretch; gap: 1rem;">
                <RadzenColumn Size="12" SizeMd="9" SizeSm="12">
                    <RadzenCard class="wx-card fade-in">
                        <div style="display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-bottom:.5rem;">
                            <div class="wx-section-title" style="display:flex; align-items:center; gap:.4rem;">
                                <RadzenIcon Icon="calendar_today" Style="font-size:22px; opacity:.8;" />
                                <span>اتفاقات امروز در تاریخ</span>
                            </div>

                            <div style="display:flex; align-items:center; gap:.6rem;">
                                <div style="opacity:.7">@(_items?.Count > 0 ? $"{_items.Count} مورد" : (IsLoading ? "در حال دریافت..." : "موردی یافت نشد"))</div>
                                <RadzenButton Icon="refresh" Text="بروزرسانی"
                                              Click="Refresh"
                                              ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" />
                            </div>
                        </div>
                        @if (IsLoading)
                        {
                            <div style="opacity:.6; padding:.5rem;">در حال دریافت...</div>
                        }
                        else
                        {
                            var featured = GetFeatured(2);

                            if (featured.Count == 0)
                            {
                                <div style="opacity:.6; padding:.5rem;">آیتمی برای نمایش نیست.</div>
                            }
                            else
                            {
                                <RadzenDataList TItem="OnThisDayItemDto" Data="@featured" AllowPaging="false" Style="max-height:none;">
                                    <Template Context="it">
                                        <RadzenCard style="margin-bottom:.8rem; padding:.9rem 1.1rem; border-radius:14px; border:px solid var(--rz-base-300);box-shadow:none !important;">
                                            <div style="display:flex; gap:14px; align-items:flex-start; flex-direction:row-reverse;" dir="rtl">
                                                @if (!string.IsNullOrWhiteSpace(it.Thumbnail))
                                                {
                                                    <img src="@it.Thumbnail"
                                                         alt="@StripHtml(it.Title)"
                                                         style="width:120px;height:120px;object-fit:cover;border-radius:12px;border:1px solid var(--rz-base-300); margin-inline-start:6px;" />
                                                }

                                                <div style="flex:1; display:flex; flex-direction:column; gap:6px; text-align:right;  box-shadow: none !important;">
                                                    <div style="display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; justify-content:flex-start;">
                                                        <span style="font-weight:900; font-size:1.05rem;">@SafeTitle(it)</span>

                                                        @if (it.Year > 0)
                                                        {
                                                            <span style="direction:ltr; background:var(--rz-base-200); color:var(--rz-text-color);
                                                                    border-radius:999px; padding:.15rem .6rem; font-size:.8rem;justify-content: center; display: flex;">
                                                                <RadzenIcon Icon="event" Style="font-size:16px;opacity:.8;margin-inline-end:.25rem;" />
                                                                @it.Year
                                                            </span>
                                                        }

                                                        <span style="background:#eef6ff; color:#0b5ed7; border:1px solid #d5e9ff;
                                                                  border-radius:999px; padding:.15rem .6rem; font-size:.8rem;justify-content: center; display: flex;">
                                                            <RadzenIcon Icon="local_offer" Style="font-size:16px;opacity:.85;margin-inline-end:.25rem;" />
                                                            @Norm(it.Type)
                                                        </span>
                                                    </div>

                                                    <div style="opacity:.9; line-height:1.9; white-space:normal;">
                                                        @StripHtml(it.Text)
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(it.PageUrl))
                                                    {
                                                        <div style="margin-top:.25rem;display:flex; justify-content:flex-start;">
                                                            <a class="rz-button rz-secondary rz-size-small"
                                                               style="display:inline-flex; align-items:center; gap:.4rem; border-radius:999px; padding:.25rem .7rem;"
                                                               href="@it.PageUrl" target="_blank" rel="noopener">
                                                                <RadzenIcon Icon="open_in_new" Style="font-size:18px; opacity:.85;" />
                                                                <span>ادامه در ویکی‌پدیا</span>
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </RadzenCard>
                                    </Template>
                                </RadzenDataList>
                            }
                        }
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMd="3" SizeSm="12">
                    <RadzenCard class="wx-card fade-in">
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            <RadzenCard class="wx-card fade-in" Style="margin-top:1rem;">
                <div class="wx-section-title">پیش‌بینی ۷ روز آینده</div>
            </RadzenCard>

            <RadzenCard class="wx-card fade-in" Style="margin-top:1rem;">
                <div class="wx-section-title">پیش‌بینی ۷ روز آینده</div>
            </RadzenCard>
        </div>

    </ChildContent>
</BasePage>

@code {
    public bool IsLoading { get; set; } = true;
    private bool _offline;
    private readonly List<OnThisDayItemDto> _items = new();

    private string _lang = "fa";
    private int _m = DateTime.Today.Month, _d = DateTime.Today.Day;

    private static string Norm(string? s) => (s ?? "").Trim().ToLowerInvariant();

    private List<OnThisDayItemDto> GetFeatured(int n)
    {
        IEnumerable<OnThisDayItemDto> src = _items.Where(i => Norm(i.Type) == "selected");
        if (!src.Any())
            src = _items.Where(i => Norm(i.Type) == "events");

        return src
            .OrderByDescending(i => !string.IsNullOrWhiteSpace(i.Thumbnail))
            .ThenByDescending(i => i.Year)
            .Take(n)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Otd.OnOtdUpdated += (_, list) =>
            {
                _items.Clear();
                if (list is not null) _items.AddRange(list);
                IsLoading = false;
                _offline = false;
                InvokeAsync(StateHasChanged);
            };

            await Otd.StartAsync();
            // یک‌بار سابسکرایب + آپدیت شبانهٔ خودکار
            await Otd.SubscribeAsync(_lang, "all", _m, _d, autoRefresh: true);
        }
        catch
        {
            _offline = true;
            IsLoading = false;
        }
    }

    private async Task Refresh()
    {
        try
        {
            IsLoading = true;
            StateHasChanged();

            await Otd.RefreshOnceAsync(_lang, "all", _m, _d);

            _offline = false;
            IsLoading = false;
        }
        catch
        {
            _offline = true;
            IsLoading = false;
        }
    }


    private static string StripHtml(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var decoded = WebUtility.HtmlDecode(s);
        // حذف تمام تگ‌های HTML
        return Regex.Replace(decoded, "<.*?>", "").Trim();
    }

    private static string SafeTitle(OnThisDayItemDto it)
        => StripHtml(!string.IsNullOrWhiteSpace(it.Title) ? it.Title : it.Text);

}
