                <RadzenCard class="chat-card card3" @onclick="() => NavManageer(AddressBar.Crypto)">
                    <div class="chat-card-icon">
                        <div class="chat-card-slot">
                            <JsonPlayer Id="3" Path="images/Crypto.json" />
                        </div>
                    </div>
                    <div class="chat-card-content">
                        <h3>قیمت لحظه ای ارز دیجیتال</h3>
                        <p>قیمت ارز های دیجیتال رو از پیگیری کن</p>
